# EDINET DB API キー（財務データ取得に使用）
# 無料取得: https://edinetdb.jp/developers
EDINET_API_KEY=edb_ここにAPIキーを貼り付ける

# Anthropic API キー（AI分析機能に使用・任意）
# 無料取得: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
